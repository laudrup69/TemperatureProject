<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA de credenciales de firma. Este fichero .example SÍ está en el repo;
  no pongas secretos reales aquí.

  Uso:
    1. Copia este fichero a  signing.local.props  (sin .example)
    2. Rellena los valores reales
    3. signing.local.props está en .gitignore — no lo commitees nunca

  Alternativa sin fichero (CI): define estas variables de entorno en su lugar:
    GOVEE_SIGNING_KEYSTORE · GOVEE_SIGNING_ALIAS
    GOVEE_SIGNING_KEYPASS  · GOVEE_SIGNING_STOREPASS

  El keystore en sí tampoco debe vivir dentro del repo: guárdalo fuera
  (p. ej. C:\keys\) y respáldalo aparte. Si lo pierdes, no podrás publicar
  actualizaciones que Android acepte sobre la app ya instalada.
-->
<Project>
	<PropertyGroup>
		<AndroidSigningKeyStore>C:\ruta\a\tu.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>tu-alias</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>TU_PASSWORD_DE_CLAVE</AndroidSigningKeyPass>
		<AndroidSigningStorePass>TU_PASSWORD_DE_ALMACEN</AndroidSigningStorePass>
	</PropertyGroup>
</Project>
