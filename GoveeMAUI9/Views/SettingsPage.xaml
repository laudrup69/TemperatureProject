<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GoveeMAUI.ViewModels"
             x:Class="GoveeMAUI.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ajustes">

    <ContentPage.Resources>
        <!-- Etiqueta de cada campo y texto de ayuda bajo él -->
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="4,4,0,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Contenido con scroll -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,8,16,16" Spacing="8">

                <!-- Govee -->
                <Label Text="SENSOR GOVEE" Style="{StaticResource SectionLabel}" Margin="16,12,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="API Key" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding GoveeApiKey}" Placeholder="Pega aquí tu API Key de Govee" />
                        </Border>

                        <Button Text="Detectar dispositivos automáticamente"
                                Command="{Binding DetectGoveeDevicesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,4" />

                        <Label Text="{Binding DeviceList}" TextColor="{StaticResource Warning}" FontSize="13" />

                        <Label Text="Device ID (autodetectado)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding GoveeDeviceId}" Placeholder="Se rellena al detectar" />
                        </Border>

                        <Label Text="Modelo (autodetectado)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding GoveeModel}" Placeholder="Se rellena al detectar" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Meross -->
                <Label Text="ENCHUFE MEROSS" Style="{StaticResource SectionLabel}" Margin="16,16,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Email de la cuenta Meross" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding MerossEmail}" Placeholder="usuario@email.com" Keyboard="Email" />
                        </Border>

                        <Label Text="Contraseña" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding MerossPassword}" IsPassword="True"
                                   Placeholder="Contraseña de la app Meross" />
                        </Border>

                        <Label Text="Secret de API (opcional)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding MerossSecret}" Placeholder="Vacío = usa valor por defecto" />
                        </Border>

                        <Label Text="Nombre del enchufe (opcional)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding MerossDevice}"
                                   Placeholder="Vacío = usa el primer enchufe de la cuenta" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Parámetros -->
                <Label Text="CONTROL" Style="{StaticResource SectionLabel}" Margin="16,16,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Umbral de temperatura (°C)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding Threshold}" Keyboard="Numeric" />
                        </Border>

                        <Label Text="Margen para apagar (°C sobre el umbral)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding HysteresisMargin}" Keyboard="Numeric" />
                        </Border>
                        <Label Text="Con umbral 19 y margen 0,5, se enciende por debajo de 19 °C y se apaga al llegar a 19,5 °C. Un margen pequeño hace que el enchufe cambie más a menudo."
                               Style="{StaticResource Caption}" FontSize="12" Margin="4,0" />

                        <Label Text="Apagado de seguridad (minutos sin lecturas)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding FailsafeMinutes}" Keyboard="Numeric" />
                        </Border>
                        <Label Text="Si el sensor deja de dar lecturas válidas durante este tiempo, se apaga el enchufe hasta que vuelvan. 0 = desactivado."
                               Style="{StaticResource Caption}" FontSize="12" Margin="4,0" />

                        <Label Text="Intervalo de comprobación (segundos)" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource Field}">
                            <Entry Text="{Binding IntervalSeconds}" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Warning}"
                       HorizontalOptions="Center" FontSize="14" Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón guardar fijo abajo -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0" Padding="16,8,16,16">
            <Button Text="Guardar ajustes" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" />
        </Border>

    </Grid>

</ContentPage>
