<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GoveeMAUI.ViewModels"
             x:Class="GoveeMAUI.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Calefacción"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

            <!-- Cabecera: título grande a la izquierda, como en iOS -->
            <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                <Label Text="Calefacción" FontSize="32" FontAttributes="Bold" VerticalOptions="End" />
                <Button Grid.Column="1" Text="Ajustes" Style="{StaticResource LinkButton}"
                        VerticalOptions="End" Clicked="OnSettingsClicked" />
            </Grid>

            <!-- Estado -->
            <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" Padding="12,6" HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="8">
                    <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                             Fill="{Binding StatusColor}" />
                    <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}"
                           FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Temperatura y humedad -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="TEMPERATURA" Style="{StaticResource SectionLabel}" />
                            <HorizontalStackLayout Spacing="2">
                                <Label Text="{Binding Temperature}" FontSize="60"
                                       FontFamily="{OnPlatform Android='sans-serif-light'}" />
                                <Label Text="°C" FontSize="26" TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="End" Margin="0,0,0,10" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Margin="0,0,0,8">
                            <Label Text="HUMEDAD" Style="{StaticResource SectionLabel}" HorizontalOptions="End" />
                            <Label HorizontalOptions="End" FontSize="26">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Humidity}" />
                                        <Span Text=" %" TextColor="{StaticResource TextSecondary}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding LastUpdate}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Caldera y umbral: lista agrupada -->
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                        <Label Text="Caldera" VerticalOptions="Center" />
                        <Label Grid.Column="1" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding PlugOn}" Value="True">
                                    <Setter Property="Text"      Value="● Encendida" />
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding PlugOn}" Value="False">
                                    <Setter Property="Text"      Value="○ Apagada" />
                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>

                    <BoxView Style="{StaticResource SeparatorLine}" Margin="16,0,0,0" />

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Padding="16,8,8,8">
                        <Label Text="Umbral" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource Field}" WidthRequest="80">
                            <Entry Text="{Binding Threshold}" Keyboard="Numeric" HorizontalTextAlignment="End" />
                        </Border>
                        <Label Grid.Column="2" Text="°C" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="Guardar" Style="{StaticResource LinkButton}"
                                FontAttributes="Bold" Command="{Binding SaveThresholdCommand}" />
                    </Grid>

                    <BoxView Style="{StaticResource SeparatorLine}" Margin="16,0,0,0" />

                    <Label Text="{Binding ControlBandText}" Style="{StaticResource Caption}" Padding="16,12" />
                </VerticalStackLayout>
            </Border>

            <!-- Control manual de la caldera -->
            <Button Command="{Binding TogglePlugManuallyCommand}"
                    Text="{Binding ManualPlugButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    BackgroundColor="{Binding ManualPlugButtonColor}"
                    TextColor="{Binding ManualPlugButtonTextColor}"
                    IsEnabled="{Binding IsManualPlugButtonEnabled}" />

            <!-- Arrancar / parar la monitorización -->
            <Button Command="{Binding ToggleMonitorCommand}" Style="{StaticResource PrimaryButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Text"            Value="Detener monitorización" />
                        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding IsRunning}" Value="False">
                        <Setter Property="Text"            Value="Iniciar monitorización" />
                        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Registro -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="REGISTRO" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding Log}" Style="{StaticResource Caption}" FontSize="12"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Versión instalada -->
            <Label Text="{Binding AppVersionText}" Style="{StaticResource Caption}" FontSize="12"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
